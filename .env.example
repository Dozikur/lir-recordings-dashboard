# Option A: paste a short-lived bearer/access token if you already generated one.
SOUNDCHARTS_ACCESS_TOKEN=

# Option B: legacy credentials. For sandbox-only testing you can set both to:
# SOUNDCHARTS_APP_ID=soundcharts
# SOUNDCHARTS_API_KEY=soundcharts
# The sandbox is free but only includes Soundcharts sample tracks, not the LIR catalog.
SOUNDCHARTS_APP_ID=
SOUNDCHARTS_API_KEY=

# Optional. Leave as-is unless Soundcharts gives you a different customer API host.
SOUNDCHARTS_BASE_URL=https://customer.api.soundcharts.com

# Option C: recommended for a free production account.
# Create API credentials in the Soundcharts dashboard and paste client id/secret.
SOUNDCHARTS_TOKEN_URL=https://account.soundcharts.com/oauth/token
SOUNDCHARTS_CLIENT_ID=
SOUNDCHARTS_CLIENT_SECRET=
SOUNDCHARTS_TEAM_ID=

# Optional SoundCloud enrichment. Create an app in SoundCloud Developers and
# add these values locally or as GitHub Actions secrets.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Optional short-lived token for local testing. Client ID/secret is better for GitHub Actions.
SOUNDCLOUD_ACCESS_TOKEN=

# Local dashboard port.
PORT=5178
